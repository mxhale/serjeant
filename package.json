{
  "name": "serjeant",
  "version": "1.0.0",
  "description": "Vim-keyed TUI: Linear issues -> worktree -> headless Claude -> diff review",
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "demo": "tsx src/cli.tsx --demo",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "build": "tsup",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.3.0",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "bin": {
    "serjeant": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  }
}
